APP_ENV=development
APP_PORT=8004
LOG_LEVEL=INFO

# PostgreSQL + TimescaleDB
POSTGRES_DSN=postgresql+asyncpg://pharma:pharma@localhost:5432/demandforecast

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# External signals
MOH_DISEASE_FEED_URL=https://api.moh.gov.vn/disease-surveillance/v1
MOH_API_KEY=replace-me
WEATHER_API_URL=https://api.tongcuckhituong.vn/v1
WEATHER_API_KEY=replace-me

# Auth
INTERNAL_API_TOKEN=replace-with-strong-random-secret

# Default forecast settings
DEFAULT_HORIZON_DAYS=30
DEFAULT_QUANTILES=0.1,0.5,0.9
